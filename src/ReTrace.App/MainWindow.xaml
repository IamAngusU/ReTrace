<Window x:Class="ReTrace.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReTrace — Dateien, Fotos und Videos zurückholen" Width="1380" Height="920" MinWidth="1120" MinHeight="760" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid Margin="28,22,28,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="45" Height="45" CornerRadius="12" Background="{DynamicResource Accent}" Margin="0,0,13,0">
          <Viewbox Width="27" Height="27"><Canvas Width="32" Height="32"><Path Stroke="#241A12" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M8,11 C11,3 25,4 27,14 C30,25 17,31 10,24 M8,4 L7,12 L15,12"/><Path Stroke="#241A12" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M14,18 L18,22 L24,15"/></Canvas></Viewbox>
        </Border>
        <StackPanel><TextBlock Text="ReTrace" FontSize="26" FontWeight="SemiBold" LineHeight="30"/><TextBlock Text="Eine zweite Chance für deine Dateien." Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="0.1 alpha 5" Foreground="{DynamicResource Muted}" Margin="0,0,18,0" VerticalAlignment="Center"/><Button x:Name="OpenCaseButton" Content="Untersuchung öffnen…" Click="OpenCase_Click" Margin="0,0,8,0"/><Button x:Name="LibraryButton" Content="Gespeicherte…" Click="Library_Click" Margin="0,0,8,0"/><Button x:Name="ThemeButton" Content="Heller Modus" Click="Theme_Click"/></StackPanel>
    </Grid>

    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,18" Margin="0,0,0,22">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Border Background="{DynamicResource Accent}" CornerRadius="14" Width="28" Height="28"><TextBlock Text="1" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Quelle wählen" FontWeight="SemiBold"/><TextBlock Text="Quelle prüfen, Original erhalten" Style="{StaticResource MutedText}"/></StackPanel></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Width="28" Height="28"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Funde prüfen" FontWeight="SemiBold"/><TextBlock Text="Dateien, Bilder und Fragmente" Style="{StaticResource MutedText}"/></StackPanel></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal"><Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Width="28" Height="28"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Kopien sichern" FontWeight="SemiBold"/><TextBlock Text="In einen neuen Rettungsordner" Style="{StaticResource MutedText}"/></StackPanel></StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}" Padding="18">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Wo fehlen deine Dateien?" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="Auch nach dem Leeren des Papierkorbs können noch Datei- und Bilddaten auf dem Datenträger liegen." Style="{StaticResource MutedText}" Margin="0,10,0,16"/>
          <TextBlock Text="Quelle" Style="{StaticResource Label}"/>
          <ComboBox x:Name="SourceMode" SelectionChanged="SourceMode_Changed"><ComboBoxItem Content="Vorhandenes Datenträgerabbild"/><ComboBoxItem Content="Laufwerk als Abbild sichern"/><ComboBoxItem Content="Windows-Papierkorb"/><ComboBoxItem Content="Ordner · Backups und Cache"/></ComboBox>
          <StackPanel x:Name="ImagePanel" Margin="0,10,0,0">
            <TextBox x:Name="SourceBox" Style="{StaticResource MonoBox}" TextWrapping="Wrap" MinHeight="66" MaxHeight="90" VerticalScrollBarVisibility="Auto" ToolTip="Absoluter Pfad zu einer regulären Raw-Abbilddatei bis 16 TiB"/>
            <Button Content="Abbild auswählen…" Click="PickSource_Click" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
          </StackPanel>
          <StackPanel x:Name="DrivePanel" Visibility="Collapsed" Margin="0,12,0,0">
            <ComboBox x:Name="VolumesBox" DisplayMemberPath="Label"/>
            <Button Content="Laufwerke aktualisieren" Click="RefreshVolumes_Click" Margin="0,8,0,0"/>
            <TextBlock Text="Das Laufwerk wird nur gelesen. Sichere das Abbild auf einem anderen physischen Datenträger. Auf aktiv genutzten Laufwerken können sich Daten währenddessen ändern." Style="{StaticResource MutedText}" Margin="0,12,0,8"/>
            <Button x:Name="CaptureButton" Content="Abbild sichern…" Click="Capture_Click"/>
            <Button x:Name="ElevateButton" Content="Als Administrator neu öffnen…" Click="Elevate_Click" Margin="0,8,0,0"/>
            <TextBlock Text="Administratorrechte werden nur für das Lesen eines Laufwerks benötigt. Ein bestehendes Abbild lässt sich ohne sie untersuchen." Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/>
          </StackPanel>
          <StackPanel x:Name="RecycleSourcePanel" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock Text="Noch im Papierkorb vorhanden?" FontWeight="SemiBold"/>
            <TextBlock Text="ReTrace liest den Papierkorb deines aktuellen Windows-Benutzers auf erreichbaren lokalen Laufwerken. Wähle danach eine Datei für eine geprüfte Kopie aus." Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
            <TextBlock x:Name="RecycleSourceLabel" Text="Quelle: aktueller Windows-Benutzer" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"/>
            <Button x:Name="CopiedRecycleButton" Content="Papierkorb-Kopie öffnen…" Click="CopiedRecycle_Click" Margin="0,12,0,0"/>
            <TextBlock Text="Nach dem Leeren des Papierkorbs sind die Windows-Einträge meist weg. Wähle dann ein Datenträgerabbild und die Bild- oder PhotoRec-Tiefensuche." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
          </StackPanel>
          <StackPanel x:Name="FolderSourcePanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBox x:Name="FolderSourceBox" Style="{StaticResource MonoBox}" MinHeight="58" TextWrapping="Wrap"/><Button Content="Ordner auswählen…" Click="PickFolder_Click" Margin="0,8,0,0"/><TextBlock Text="Durchsucht vorhandene Dateien, auch versteckte, nach Foto- und Videodaten. Eingebettete Kopien oder Vorschaubilder können kleiner als das Original sein. Gelöschte freie Sektoren sind in einem normalen Ordner nicht enthalten." Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"/></StackPanel>
          <StackPanel x:Name="ImageSearchSettings">
          <TextBlock x:Name="SearchModeLabel" Text="Suchmodus" Style="{StaticResource Label}"/>
          <ComboBox x:Name="EngineBox" SelectionChanged="Engine_Changed"><ComboBoxItem Content="Mediensuche · integriert"/><ComboBoxItem Content="Tiefensuche · PhotoRec"/></ComboBox>
          <TextBlock x:Name="EngineDescription" Style="{StaticResource MutedText}" Margin="0,9,0,0"/>
          <StackPanel x:Name="NativeScopePanel"><TextBlock Text="Gesuchte Medien" Style="{StaticResource Label}"/><ComboBox x:Name="MediaScopeBox" SelectionChanged="MediaScope_Changed"><ComboBoxItem Content="Fotos · JPEG und PNG"/><ComboBoxItem Content="Videos · MP4, MOV und AVI"/><ComboBoxItem Content="Fotos und Videos"/></ComboBox></StackPanel>
          <StackPanel x:Name="DeepScopePanel" Visibility="Collapsed"><TextBlock Text="Dateitypen für PhotoRec" Style="{StaticResource Label}"/><ComboBox x:Name="DeepScopeBox" SelectionChanged="DeepScope_Changed"><ComboBoxItem Content="Fotos · JPEG und PNG"/><ComboBoxItem Content="Alle PhotoRec-Dateitypen"/><ComboBoxItem Content="Dokumente · PDF und ZIP"/><ComboBoxItem Content="Videos · fünf Formatfamilien"/><ComboBoxItem Content="Fotos und Video-Familien"/></ComboBox></StackPanel>
          <StackPanel x:Name="DeepVideoPanel" Visibility="Collapsed"><TextBlock Text="MP4/MOV, AVI, MKV/WebM, ASF/WMV und MPEG. Formatfamilien können auch Audio oder verwandte Container liefern." Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/><CheckBox x:Name="DeepMdatCheck" Content="Separate mdat-Fragmente behalten" ToolTip="Erhält rohe Videodaten ohne automatisch fehlende Metadaten zu ergänzen. Keine automatische Zusammenfügung oder Abspielgarantie." Margin="0,9,0,0"/></StackPanel>
          <Button x:Name="VideoPresetButton" Content="Video-Profil · 256 MiB je Fund" Click="VideoPreset_Click" Visibility="Collapsed" Margin="0,12,0,0"/>
          <CheckBox x:Name="FragmentsCheck" IsChecked="True" Content="Auch beschädigte Funde und Fragmente behalten" Margin="0,16,0,0"/>
          <Expander x:Name="ProfileExpander" Header="Suchprofil anpassen" Margin="0,16,0,0" Foreground="{DynamicResource Ink}"><StackPanel Margin="0,5,0,0">
            <TextBlock Text="Maximale Fundanzahl" Style="{StaticResource Label}"/><TextBox x:Name="MaximumCandidatesBox" Text="10000" ToolTip="1 bis 100.000 Funde; bei der Bildsuche untersuchte Signaturen"/>
            <TextBlock Text="Maximale Dateigröße · MiB" Style="{StaticResource Label}"/><TextBox x:Name="MaximumFileMiBBox" Text="64" ToolTip="1 bis 1.024 MiB; Bildvorschau bleibt auf 64 MiB begrenzt"/>
            <StackPanel x:Name="FolderLimitsPanel" Visibility="Collapsed"><TextBlock Text="Maximale Quelldateien" Style="{StaticResource Label}"/><TextBox x:Name="FolderMaximumFilesBox" Text="256"/><TextBlock Text="Gesamtbudget · MiB" Style="{StaticResource Label}"/><TextBox x:Name="FolderMaximumMiBBox" Text="512"/><TextBlock Text="Größe je Quelldatei · MiB" Style="{StaticResource Label}"/><TextBox x:Name="FolderContainerMiBBox" Text="128"/><TextBlock Text="Verzeichnistiefe 8 · höchstens 10.000 Einträge. Links werden nicht verfolgt. Übersprungene oder unlesbare Quellen bleiben als Abdeckungslücke sichtbar." Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"/></StackPanel>
            <StackPanel x:Name="DeepLimitsPanel" Visibility="Collapsed"><TextBlock Text="PhotoRec-Ausgabe · GiB" Style="{StaticResource Label}"/><TextBox x:Name="MaximumOutputGiBBox" Text="4" ToolTip="1 bis 1.024 GiB; überwachte Abbruchgrenze, kein Datenträgerkontingent"/><TextBlock Text="PhotoRec-Laufzeit · Minuten" Style="{StaticResource Label}"/><TextBox x:Name="TimeoutMinutesBox" Text="60" ToolTip="1 bis 10.080 Minuten; gilt für den PhotoRec-Prozess"/></StackPanel>
            <TextBlock Text="Beim Erreichen einer Grenze bleibt das Ergebnis als unvollständig gekennzeichnet. Es ist keine vollständige Datenträgeranalyse." Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"/>
          </StackPanel></Expander>
          </StackPanel>
          <Expander Header="Weitere Spuren und Quellen" Margin="0,17,0,0" Foreground="{DynamicResource Ink}"><StackPanel Margin="0,8,0,0">
            <TextBlock Text="Freie Datenträgerbereiche" FontWeight="SemiBold"/><TextBlock Text="Bild-/PhotoRec-Suche im Raw-Abbild kann verbliebene Signaturen auch nach dem Leeren finden. Namen und Löschstatus bleiben beim Carving häufig unbekannt." Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,12"/>
            <TextBlock Text="Backups und ältere Dateikopien" FontWeight="SemiBold"/><TextBlock Text="Dateiversionsverlauf, Cloud-Papierkorb, Versionsstände oder vorhandene Schattenkopien können frühere Inhalte enthalten. Diese Quellen werden hier nicht automatisch abgefragt." Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,12"/>
            <TextBlock Text="Vorschaubilder und exportierte Caches" FontWeight="SemiBold"/><TextBlock Text="Wähle „Ordner · Backups und Cache“, um vorhandene versteckte Dateien und eingebettete JPEG-/PNG-Daten zu suchen. Gefundene Kopien können kleiner oder älter sein; verschlüsselte Container werden nicht automatisch entschlüsselt." Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel></Expander>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,16,0,0"><TextBlock Text="Jetzt möglichst wenig auf das betroffene Laufwerk schreiben. Überschriebene oder durch SSD-TRIM entfernte Daten lassen sich möglicherweise nicht zurückholen." Style="{StaticResource MutedText}"/></Border>
        </StackPanel></ScrollViewer><StackPanel Grid.Row="1" Margin="0,14,0,0"><Button x:Name="ScanButton" Content="Bilder suchen" Style="{StaticResource Primary}" Click="Scan_Click"/><Button x:Name="CancelButton" Content="Vorgang abbrechen" Click="Cancel_Click" IsEnabled="False" Margin="0,8,0,0"/></StackPanel></Grid>
      </Border>

      <Grid x:Name="ImageResultsPanel" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="ResultsTitle" Text="Deine Funde" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="ResultsSummary" Text="Wähle ein Abbild und starte die Suche." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="KindFilter" Width="125" Margin="0,0,8,0" SelectionChanged="Filter_Changed"/><ComboBox x:Name="StateFilter" Width="160" SelectionChanged="Filter_Changed"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel}" Padding="0"><Grid>
            <DataGrid x:Name="CandidatesGrid" SelectionMode="Extended" SelectionChanged="Selection_Changed" MouseDoubleClick="Candidate_DoubleClick" CanUserSortColumns="True">
              <DataGrid.Columns><DataGridTextColumn Header="Fund / Container" Binding="{Binding DisplayName}" Width="*" MinWidth="115"/><DataGridTextColumn Header="Zustand" Binding="{Binding StateLabel}" Width="148"/><DataGridTextColumn Header="Größe" Binding="{Binding SizeLabel}" Width="84"/></DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"><TextBlock Text="Was noch da ist, zählt." FontSize="21" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Hier erscheinen die gefundenen Dateien.&#10;Du entscheidest, was du sicherst." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,0"/></StackPanel>
          </Grid></Border>
          <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="15"><Grid><Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource Input}" CornerRadius="5"><Grid><Image x:Name="PreviewImage" Stretch="Uniform" Margin="8"/><TextBlock x:Name="PreviewPlaceholder" Text="Bild für die Vorschau auswählen" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="22" VerticalAlignment="Center"/></Grid></Border>
            <StackPanel Grid.Row="1" Margin="0,14,0,0"><TextBlock x:Name="PreviewTitle" Text="Vorschau" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="PreviewStatus" Text="Eine Vorschau zeigt, was sich bereits lesen lässt." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel>
            <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="CandidateDetails" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" LineHeight="18" FontFamily="Cascadia Mono, Consolas"/></ScrollViewer>
          </Grid></Border>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,17,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="SelectionSummary" Text="Noch keine Funde ausgewählt" FontWeight="SemiBold"/><TextBlock Text="Signaturfunde können vorhandene Kopien sein. Löschstatus und Abspielbarkeit sind dadurch nicht nachgewiesen." Style="{StaticResource MutedText}" FontSize="11" MaxWidth="440" Margin="0,5,12,0"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="ClearCaseButton" Content="Schließen" Click="ClearCase_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="SaveLibraryButton" Content="Merken" Click="SaveLibrary_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="ReportButton" Content="Bericht sichern…" Click="SaveReport_Click" ToolTip="Als später wieder zu öffnende Untersuchung sichern" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="ExportButton" Content="Auswahl sichern…" Style="{StaticResource Primary}" Click="Export_Click" IsEnabled="False"/></StackPanel>
        </Grid></Border>
      </Grid>
      <Grid x:Name="RecycleResultsPanel" Grid.Column="2" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14"><TextBlock x:Name="RecycleTitle" Text="Dein Windows-Papierkorb" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="RecycleSummary" Text="Lies den Papierkorb, um noch vorhandene Einträge und ihre ursprünglichen Pfade zu sehen." Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0"><Grid><DataGrid x:Name="RecycleGrid" SelectionMode="Single" SelectionChanged="RecycleSelection_Changed"><DataGrid.Columns><DataGridTextColumn Header="Datei" Binding="{Binding Name}" Width="*" MinWidth="110"/><DataGridTextColumn Header="Ursprünglicher Pfad" Binding="{Binding OriginalPath}" Width="2*" MinWidth="150"/><DataGridTextColumn Header="Gelöscht" Binding="{Binding DeletedLabel}" Width="138"/><DataGridTextColumn Header="Größe" Binding="{Binding SizeLabel}" Width="82"/><DataGridTextColumn Header="Zustand" Binding="{Binding StateLabel}" Width="145"/></DataGrid.Columns></DataGrid><TextBlock x:Name="RecycleEmpty" Text="Noch kein Papierkorb gelesen.&#10;Klicke auf „Papierkorb lesen“." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="22"/></Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="RecycleDetails" Text="Eintrag auswählen: Herkunft, Metadatengröße, Nutzdaten und Diagnose erscheinen hier." FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" LineHeight="18"/></ScrollViewer></Border>
        <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,17,0,0" Padding="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock x:Name="RecycleSelectionSummary" Text="Noch kein Eintrag ausgewählt" FontWeight="SemiBold"/><TextBlock Text="Gesichert wird eine neue Kopie. Der Papierkorb und ursprüngliche Zielpfade werden nicht verändert. Ordner werden gesondert als nicht unterstützt markiert." Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RecycleClearButton" Content="Liste leeren" Click="RecycleClear_Click" Margin="0,0,8,0"/><Button x:Name="RecycleReportButton" Content="Bericht sichern…" Click="RecycleReport_Click" Margin="0,0,8,0"/><Button x:Name="RecycleRestoreButton" Content="Kopie wiederherstellen…" Style="{StaticResource Primary}" Click="RecycleRestore_Click" IsEnabled="False"/></StackPanel></Grid></Border>
      </Grid>
    </Grid>

    <Border Grid.Row="3" Margin="0,18,0,0" Background="{DynamicResource Surface}" CornerRadius="7" Padding="14,11"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="StatusLabel" Text="Bereit. Die Quelle wird nur gelesen." FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ProgressDetail" Text="Integriert: JPEG, PNG, MP4/MOV und AVI · weitere Formatfamilien über PhotoRec" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
      <Button x:Name="OpenOutputButton" Grid.Column="1" Content="Rettungsordner öffnen" Visibility="Collapsed" Click="OpenOutput_Click" Margin="16,0,0,0"/>
      <ProgressBar x:Name="WorkProgress" Grid.Row="1" Grid.ColumnSpan="2" Height="3" Margin="0,10,0,0" Maximum="100" Value="0"/>
    </Grid></Border>
  </Grid>
</Window>
