<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ReTraceCoreProject Condition="'$(ReTraceCoreProject)' == ''">../../src/ReTrace.Core/ReTrace.Core.csproj</ReTraceCoreProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ReTraceCoreProject)" />
  </ItemGroup>
</Project>
